{
    "name": "udodi",
    "version": "1.0.3",
    "description": "A lightweight UI/component framework",
    "private": false,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "homepage": "https://github.com/udodi-js/udodi",
    "bugs": {
        "url": "https://github.com/udodi-js/udodi/issues"
    },
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup && node scripts/postbuild.js",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "ui",
        "framework",
        "components",
        "udodi",
        "template",
        "overlay",
        "modal",
        "store",
        "query",
        "worker"
    ],
    "author": "Attamah Celestine .C",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/udodi-js/udodi.git"
    },
    "devDependencies": {
        "@vitest/ui": "^4.1.8",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.10.2",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    }
}
